{
  "name": "ai-securite-publique",
  "version": "1.0.0",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/jest": "^30.0.0",
    "artillery": "^2.0.34",
    "artillery-plugin-metrics-by-endpoint": "^1.27.0",
    "babel-jest": "^30.5.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "husky": "^9.1.7",
    "jest": "^30.5.0",
    "jest-mock": "^30.5.0",
    "jest-snapshot": "^30.5.0",
    "mongodb-memory-server": "^11.2.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12"
  },
  "scripts": {
  "prepare": "husky",
  "test": "jest",
  "test:unit": "jest --runTestsByPath dossier_test/unit_test --passWithNoTests",
  "test:integration": "jest --runTestsByPath dossier_test/integration_test --passWithNoTests",
  "test:component": "jest --runTestsByPath dossier_test/component_test --passWithNoTests",
  "test:sentinelle": "jest --runTestsByPath dossier_test/sentinelle_test",
  "test:e2e": "playwright test",
  "test:load": "artillery run dossier_test/load_test/load.yml",
  "test:all": "npm run test && npm run test:e2e && npm run test:load",
  "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
  "prettier": "prettier --write ."
},
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0"
  }
}
