  "type": "module",
  "main": "server.js",
 "scripts": {
  "start": "node server.js",
  "dev": "nodemon server.js",
  "lint": "eslint . --ext .js,.ts,.tsx --fix",
  "format": "prettier --write .",
  "test": "jest --ci",
  "test:unit": "jest --runTestsByPath dossier_test/unit_test",
  "test:integration": "jest --runTestsByPath dossier_test/integration_test",
  "test:coverage": "jest --coverage",
  "test:sentinel": "jest dossier_test/regression_test/sentinel/all_test_ok.test.ts",
  "test:all": "npm run test && npm run test:coverage && npm run test:sentinel",
  "mutate": "stryker run",
  "sonar": "sonar-scanner"
},
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "eslint": "^8.49.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-security": "^1.4.0",
    "eslint-plugin-sonarjs": "^1.0.3",
    "jest": "^29.7.0",
    "prettier": "^3.0.0"
    
  }
}
